APP_NAME="Kaleni Catering Services"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://kalenicatering.example

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Admin panel URL prefix. Set this to a private, unguessable value in your real
# .env (never commit the real value). Do not list it in robots.txt.
ADMIN_PATH=admin

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail (Contact form → CONTACT_EMAIL_INFO). Production: use smtp — Kaleni
# currently uses a Gmail address, so either use Gmail's SMTP with an app
# password, or move to a business domain's mailbox before going live.
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=kalenilucas061@gmail.com
MAIL_PASSWORD=your-smtp-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="kalenilucas061@gmail.com"
MAIL_FROM_NAME="Kaleni Catering Services"
# Local dev: MAIL_MAILER=log, MAIL_HOST=127.0.0.1, MAIL_PORT=2525, MAIL_USERNAME=null, MAIL_PASSWORD=null

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Contact (used site-wide)
CONTACT_PHONE=+264813382817
CONTACT_EMAIL_INFO=kalenilucas061@gmail.com
CONTACT_EMAIL_ORDERS=kalenilucas061@gmail.com
# CONTACT_PO_BOX=

# Inventory (stock count)
INVENTORY_LOW_STOCK_THRESHOLD=5

# Social (footer, contact page). TikTok handle unknown — set if/when created.
SOCIAL_FACEBOOK=https://www.facebook.com/p/Kaleni-Catering-Services-100076815163927/
SOCIAL_INSTAGRAM=https://www.instagram.com/kaleni_catering_services/
# SOCIAL_TIKTOK=https://www.tiktok.com/@...

# WhatsApp (floating button, payment link)
WHATSAPP_PAYMENT_NUMBER=264813382817
SOCIAL_WHATSAPP=https://wa.me/264813382817
# WhatsApp Channel (Meta > Business tools > Channels). Leave unset to hide the "Follow" link.
# SOCIAL_WHATSAPP_CHANNEL=https://whatsapp.com/channel/xxxxxxxxxxxxx

# DPO Group (3G Direct Pay) — online card payment. Leave DPO_COMPANY_TOKEN unset
# and the storefront automatically keeps "Pay with DPO" disabled/"Coming soon";
# WhatsApp booking keeps working either way. Once DPO approves the merchant
# account, paste the Company Token below and DPO appears on booking with no
# code changes needed.
# DPO_COMPANY_TOKEN=
# DPO_SERVICE_TYPE=1
# DPO_TEST_MODE=true
# DPO_CURRENCY=NAD
